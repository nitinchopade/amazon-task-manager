# Database configuration
POSTGRES_USER=amazon
POSTGRES_PASSWORD=password
POSTGRES_DB=taskdb
DATABASE_URL=postgresql://amazon:password@db:5432/taskdb

# Flask configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-secret-key

# Gunicorn configuration
WORKERS=4
TIMEOUT=120

# Logging
LOG_LEVEL=INFO